generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS — harus identik dengan frontend/src/types/enums.ts
// ============================================================

enum UserRole {
  SUPER_ADMIN
  LOGISTICS
  COORDINATOR
  TECHNICAL_IT
  TECHNICAL_ELECTRICAL
  TECHNICAL_SARPRAS
  REGISTRAR
  SUPERVISOR
  PIMPINAN
  PPK
  INSPEKTORAT
}

enum LocationStatus {
  PREPARATION
  INSTALLATION_IN_PROGRESS
  READY
  CLOSED
}

enum InstallationMilestone {
  LAYOUT_20
  INFRASTRUCTURE_50
  DEPLOYMENT_80
  COMPLETED_100
}

enum TicketSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  IT_SOFTWARE
  IT_HARDWARE
  ELECTRICAL
  NETWORK
  SARPRAS
  OTHER
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  ESCALATED
  CLOSED
}

enum ShipmentStatus {
  PACKING
  IN_TRANSIT
  ARRIVED
  RECEIVED
  RETURNED
}

enum InventoryCategory {
  LAPTOP_CLIENT
  SERVER
  UPS
  NETWORK
  METAL_DETECTOR
  CCTV
  TENTA
  AC
  GENERATOR
  OTHER
}

enum StagePhase {
  PERSIAPAN
  INSTALASI
  UJI_FUNGSI
  PELAKSANAAN
  DEINSTALASI
  SERAH_TERIMA
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// Kategori dokumentasi foto/video pada tahapan (spesifikasi instansi penyelenggara:
// "foto dan video barang" vs "foto dan video sesi ujian").
enum StagePhotoCategory {
  BARANG
  SESI_UJIAN
  UMUM
}

enum BeritaAcaraType {
  BA_PENGANTARAN
  BA_UJI_FUNGSI
  BA_PERUBAHAN_VOLUME
  BA_HARIAN
  BA_KENDALA
  BA_DEINSTALASI
  BA_SERAH_TERIMA
}

enum BeritaAcaraStatus {
  DRAFT
  PENDING_APPROVAL
  FINAL
  REJECTED
}

enum TransportMode {
  DARAT
  LAUT
  UDARA
}

enum DeliveryType {
  CARGO
  EKSPEDISI
  DIANTAR_LANGSUNG
}

enum ItemOwnership {
  MILIK_SENDIRI
  SEWA
}

enum ItemCondition {
  BAIK
  RUSAK_RINGAN
  RUSAK_BERAT
}

enum PersonnelRole {
  KOORDINATOR
  TENAGA_IT
  ELEKTRIKAL
  TENAGA_SARPRAS
  PENGAWAS_INSTANSI
}

enum DocumentCategory {
  KONTRAK
  SURAT_TUGAS
  BERITA_ACARA
  LAPORAN
  FOTO_DOKUMENTASI
  LAINNYA
}

enum RegencyType {
  KABUPATEN
  KOTA
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  name        String
  phone       String?
  role        UserRole
  instansi    String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  // Lokasi tempat user bertugas (banyak user → satu lokasi)
  locationId String?
  location   Location? @relation("UserWorkLocation", fields: [locationId], references: [id], onDelete: SetNull)

  sessions UserSession[]
  loginAttempts LoginAttempt[]
  uploadedFiles UploadedFile[]
  notifications Notification[]
  projects Project[]

  // Relations
  auditLogs             AuditLog[]
  assignedTickets       IncidentTicket[]    @relation("AssignedTechnician")
  reportedTickets       IncidentTicket[]    @relation("TicketReporter")
  createdShipments      LogisticsShipment[]
  createdBeritaAcara    BeritaAcara[]
  approvedBeritaAcara   BeritaAcara[]       @relation("BeritaAcaraApprover")
  uploadedDocuments     LocationDocument[]
  completedStages       LocationStage[]
  coordinatedLocations  Location[]          @relation("LocationCoordinator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([locationId])
}

// ============================================================
// LOCATIONS
// ============================================================

model Location {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  province      String
  city          String
  address       String
  latitude      Decimal        @db.Decimal(10, 8)
  longitude     Decimal        @db.Decimal(11, 8)
  status        LocationStatus @default(PREPARATION)
  capacity      Int            @default(0)
  startDate     DateTime?
  endDate       DateTime?
  metadata      Json?

  coordinatorId String?
  coordinator   User?   @relation("LocationCoordinator", fields: [coordinatorId], references: [id])

  uploadedFiles UploadedFile[]
  notifications Notification[]
  projectLocation ProjectLocation?

  // Relations
  users                User[]                @relation("UserWorkLocation")
  installationProgress InstallationProgress[]
  inventoryChecklists  InventoryChecklist[]
  incidentTickets      IncidentTicket[]
  shipments            LogisticsShipment[]
  stages               LocationStage[]
  beritaAcara          BeritaAcara[]
  locationItems        LocationItem[]
  personnel            Personnel[]
  documents            LocationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([province, city])
  @@index([status])
  @@index([coordinatorId])
}

// ============================================================
// INSTALLATION PROGRESS
// ============================================================

model InstallationProgress {
  id         String                @id @default(uuid())
  locationId String
  location   Location              @relation(fields: [locationId], references: [id], onDelete: Cascade)
  milestone  InstallationMilestone
  percentage Int                   @default(0)
  notes      String?
  photos     Json?                 // Array<{ url, lat, lng, timestamp }>
  completedBy String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, milestone])
  @@index([locationId])
}

// ============================================================
// INCIDENT TICKETS
// ============================================================

model IncidentTicket {
  id           String         @id @default(uuid())
  ticketNumber String         @unique
  locationId   String
  location     Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  reportedBy   String
  reporter     User           @relation("TicketReporter", fields: [reportedBy], references: [id])
  reporterName String

  assignedTo   String?
  assignee     User?          @relation("AssignedTechnician", fields: [assignedTo], references: [id])

  severity     TicketSeverity
  category     TicketCategory
  status       TicketStatus   @default(OPEN)
  title        String
  description  String
  photos       Json?          // string[]

  slaMinutes   Int            @default(30)
  slaExpiresAt DateTime
  resolvedAt   DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId, status])
  @@index([assignedTo])
  @@index([slaExpiresAt])
}

// ============================================================
// INVENTORY
// ============================================================

model InventoryItem {
  masterItemId String? @unique
  masterItem MasterItem? @relation(fields: [masterItemId], references: [id], onDelete: SetNull)
  id           String            @id @default(uuid())
  code         String            @unique
  name         String
  category     InventoryCategory
  standardQty  Int
  specifications Json?
  imageUrl     String?

  checklists   InventoryChecklist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryChecklist {
  id          String        @id @default(uuid())
  locationId  String
  location    Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])

  expectedQty Int
  receivedQty Int     @default(0)
  damagedQty  Int     @default(0)
  missingQty  Int     @default(0)
  notes       String?
  photos      Json?   // string[]

  verifiedBy  String?
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, itemId])
  @@index([locationId])
}

// ============================================================
// LOGISTICS SHIPMENTS
// ============================================================

model LogisticsShipment {
  id              String         @id @default(uuid())
  shipmentNumber  String         @unique
  originWarehouseId String
  destinationLocationId String
  destination     Location       @relation(fields: [destinationLocationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id])

  status        ShipmentStatus @default(PACKING)
  manifestItems Json           // Array<{ itemId, qty }>
  trackingNotes String?

  shippedAt   DateTime?
  arrivedAt   DateTime?
  receivedBy  String?
  receivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([destinationLocationId, status])
  @@index([originWarehouseId])
}

// ============================================================
// TAHAPAN KERJA (STAGES)
// ============================================================

model LocationStage {
  id          String      @id @default(uuid())
  locationId  String
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  phase       StagePhase
  status      StageStatus @default(NOT_STARTED)
  progress    Int         @default(0)
  notes       String?
  startedAt   DateTime?
  completedAt DateTime?

  completedById String?
  completedBy   User?   @relation(fields: [completedById], references: [id])

  photos StagePhoto[]

  updatedAt DateTime @updatedAt

  @@unique([locationId, phase])
  @@index([locationId])
}

model StagePhoto {
  id          String             @id @default(uuid())
  stageId     String
  stage       LocationStage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  url         String
  caption     String
  category    StagePhotoCategory @default(UMUM)
  takenAt     DateTime
  uploadedBy  String

  createdAt DateTime @default(now())

  @@index([stageId])
}

// ============================================================
// BERITA ACARA
// ============================================================

model BeritaAcara {
  id             String            @id @default(uuid())
  documentNumber String            @unique
  type           BeritaAcaraType
  status         BeritaAcaraStatus @default(DRAFT)
  locationId     String
  location       Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  title          String
  date           DateTime
  body           String
  fileUrl        String?
  fileName       String?

  // Alur approval: koordinator upload -> pengawas lapangan menyetujui/menolak
  approvedById  String?
  approvedBy    User?     @relation("BeritaAcaraApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  rejectionNote String?

  // Khusus BA Pengantaran
  transportMode  TransportMode?
  deliveryType   DeliveryType?
  courierName    String?
  vehicleInfo    String?
  items          Json?             // Array<{ name, qty, unit }>

  // Penandatangan
  pihakPertamaNama     String
  pihakPertamaJabatan  String
  pihakPertamaInstansi String
  pihakKeduaNama       String
  pihakKeduaJabatan    String
  pihakKeduaInstansi   String

  photos Json?  // StagePhoto[]

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId, type])
  @@index([status])
}

// ============================================================
// BARANG DI TITIK LOKASI
// ============================================================

model LocationItem {
  masterItemId String?
  masterItem MasterItem? @relation(fields: [masterItemId], references: [id], onDelete: SetNull)
  supplyAllocations LocationSupplyAllocation[]
  id              String        @id @default(uuid())
  locationId      String
  location        Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name            String
  qty             Int
  unit            String
  ownership       ItemOwnership @default(MILIK_SENDIRI)
  condition       ItemCondition @default(BAIK)
  installationPct Int           @default(0)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@unique([locationId, masterItemId])
}

// ============================================================
// PERSONEL SDM
// ============================================================

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

// Jenjang pendidikan — Kepsesma 240/2026 huruf G.1 poin 8 mensyaratkan
// tenaga teknis minimal SMA sederajat, sehingga opsi dimulai dari SMA/SMK.
enum EducationLevel {
  SMA_SMK
  D3
  S1
  S2
}

model Personnel {
  id         String        @id @default(uuid())
  // Penugasan titik lokasi — nullable: tenaga teknis bisa terdaftar di
  // master tanpa penugasan, lalu ditugaskan/dipindahkan antar tilok.
  locationId String?
  location   Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  name       String
  role       PersonnelRole
  phone      String?
  notes      String?

  // ── Data pribadi ──
  nik        String?
  birthPlace String?
  birthDate  DateTime?
  gender     Gender?
  address    String?
  email      String?

  // ── Pendidikan & ijazah (min. SMA sederajat sesuai Kepsesma) ──
  educationLevel       EducationLevel?
  educationMajor       String?
  educationInstitution String?
  diplomaFileUrl       String? // file ijazah ter-upload
  diplomaFileName      String?

  // ── Honor & rekomendasi ──
  honorPerDay     Decimal?       @db.Decimal(14, 2) // honor per hari kegiatan (Rp)
  recommendedRole PersonnelRole? // grade jabatan yang direkomendasikan

  attendances PersonnelAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
}

model PersonnelAttendance {
  id          String    @id @default(uuid())
  personnelId String
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  locationId  String
  date        DateTime  @db.Date
  present     Boolean   @default(false)
  notes       String?
  // Bukti kehadiran yang di-upload admin (base64 data URL)
  fileUrl     String?
  fileName    String?

  createdAt DateTime @default(now())

  @@unique([personnelId, date])
  @@index([locationId, date])
}

// ============================================================
// DOKUMEN LOKASI
// ============================================================

model LocationDocument {
  id          String           @id @default(uuid())
  locationId  String
  location    Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  category    DocumentCategory
  name        String
  fileName    String
  fileUrl     String
  fileSizeKb  Int?
  notes       String?

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId, category])
}

// ============================================================
// MASTER DATA — STANDAR ITEM & TENAGA TEKNIS PER KAPASITAS
// Sumber: Kepsesma BKN No 240 Tahun 2026 — Lampiran E
// (38 item standar) dan huruf D.4.e Tenaga Teknis
// (tier 100–500 peserta/sesi).
// ============================================================

// Kategori sarana prasarana — dasar pemetaan vendor per kategori
// (vendor rental IT vs vendor perlengkapan event/non-IT).
enum SarprasCategory {
  SARPRAS_IT
  SARPRAS_NON_IT
}

model MasterItem {
  id        String          @id @default(uuid())
  no        Int             @unique // urutan sesuai Lampiran E Kepsesma 240/2026
  name      String
  unit      String
  ownership ItemOwnership   @default(SEWA)
  category  SarprasCategory @default(SARPRAS_NON_IT)

  // Kuantitas standar per tier kapasitas (peserta per sesi)
  qty100 Int
  qty200 Int
  qty300 Int
  qty400 Int
  qty500 Int

  isActive Boolean @default(true)
  notes    String?

  vendorItems VendorItem[]
  inventoryItem InventoryItem?
  locationItems LocationItem[]
  projectRequirements ProjectRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MasterPersonnelRequirement {
  id          String @id @default(uuid())
  capacity    Int    @unique // 100 / 200 / 300 / 400 / 500
  koordinator Int
  tenagaIt    Int
  elektrikal  Int
  sarpras     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String @id @default(uuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================
// MASTER DATA — WILAYAH INDONESIA (Provinsi & Kabupaten/Kota)
// ============================================================

model Province {
  id   String @id @default(uuid())
  code String @unique // kode Kemendagri, mis. '11'
  name String @unique

  projectLocations ProjectLocation[]
  regencies       Regency[]
  vendorDomiciles Vendor[]         @relation("VendorDomicile")
  vendorCoverages VendorCoverage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PENGADAAN — FASE 1: MASTER VENDOR REKANAN
// Vendor pemasok sarpras (IT / Non IT) milik penyedia katalog.
// Cakupan wilayah many-to-many: satu vendor bisa melayani banyak
// provinsi, satu provinsi bisa dilayani banyak vendor.
// ============================================================

model Vendor {
  id         String            @id @default(uuid())
  code       String            @unique // auto: VDR-0001
  name       String
  categories SarprasCategory[] // IT saja, Non IT saja, atau keduanya

  npwp    String?
  nib     String?
  kbli    String?
  address String?

  provinceId String?
  province   Province? @relation("VendorDomicile", fields: [provinceId], references: [id], onDelete: SetNull)

  picName  String?
  picPhone String?
  email    String?

  rating   Int? // 1-5 penilaian kinerja internal
  isActive Boolean @default(true)
  notes    String?

  coverages VendorCoverage[]
  items     VendorItem[]
  projectAllocations ProjectAllocation[]
  locationAllocations LocationSupplyAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Satuan harga vendor: per hari kegiatan (dikali jumlah hari) atau
// per event (flat sekali per kegiatan, tidak tergantung jumlah hari).
enum PriceUnit {
  PER_HARI
  PER_EVENT
}

// Katalog barang & harga vendor: item yang sanggup dipasok vendor
// (mengacu MasterItem), jumlah maksimal, harga satuan + satuannya.
// Menjadi dasar pemilihan harga terbaik saat menyusun penawaran.
model VendorItem {
  projectAllocations ProjectAllocation[]
  id       String @id @default(uuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  masterItemId String
  masterItem   MasterItem @relation(fields: [masterItemId], references: [id], onDelete: Cascade)

  qty       Int // jumlah maksimal yang sanggup dipasok
  unitPrice Decimal   @db.Decimal(14, 2) // harga satuan
  priceUnit PriceUnit @default(PER_HARI) // per hari / per event
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, masterItemId])
  @@index([masterItemId])
}

model VendorCoverage {
  id       String @id @default(uuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  provinceId String
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([vendorId, provinceId])
  @@index([provinceId])
}

model Regency {
  projectLocations ProjectLocation[]
  id   String      @id @default(uuid())
  code String      @unique // kode Kemendagri, mis. '11.01'
  name String
  type RegencyType

  provinceId String
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provinceId, name])
  @@index([provinceId])
}


model UserSession {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshId String
  refreshIssuedAt DateTime
  refreshTokenHash String
  previousTokenHash String?
  previousValidUntil DateTime?
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  lastUsedAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model LoginAttempt {
  id String @id @default(uuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  email String
  ipAddress String?
  userAgent String?
  success Boolean
  createdAt DateTime @default(now())
  @@index([email, createdAt])
  @@index([createdAt])
}

model UploadedFile {
  id String @id @default(uuid())
  filename String @unique
  originalName String
  mimeType String
  sizeBytes Int
  uploadedById String
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  locationId String?
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([locationId])
  @@index([uploadedById])
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String?
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type String
  dedupeKey String
  title String
  message String
  href String
  severity NotificationSeverity @default(INFO)
  readAt DateTime?
  createdAt DateTime @default(now())
  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

enum ProjectStatus {
  DRAFT
  PENYUSUNAN_PENAWARAN
  DIAJUKAN
  MENANG
  KALAH
  OPERASIONAL
  SELESAI
  DIBATALKAN
}

model Project {
  id String @id @default(uuid())
  code String @unique
  name String
  agencyName String
  fiscalYear Int
  description String?
  hpsAmount Decimal? @db.Decimal(18,2)
  defaultMarginPct Decimal @default(10) @db.Decimal(5,2)
  startDate DateTime?
  endDate DateTime?
  submissionDeadline DateTime?
  submittedAt DateTime?
  status ProjectStatus @default(DRAFT)
  createdById String
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  locations ProjectLocation[]
  proposals ProjectProposal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, fiscalYear])
}

model ProjectLocation {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name String
  provinceId String
  province Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  regencyId String?
  regency Regency? @relation(fields: [regencyId], references: [id], onDelete: SetNull)
  city String
  capacity Int
  days Int @default(5)
  address String?
  latitude Decimal? @db.Decimal(10,8)
  longitude Decimal? @db.Decimal(11,8)
  locationId String? @unique
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  requirements ProjectRequirement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projectId])
}

model ProjectRequirement {
  id String @id @default(uuid())
  projectLocationId String
  projectLocation ProjectLocation @relation(fields: [projectLocationId], references: [id], onDelete: Cascade)
  masterItemId String
  masterItem MasterItem @relation(fields: [masterItemId], references: [id], onDelete: Restrict)
  name String
  unit String
  ownership ItemOwnership
  qty Int
  marginPct Decimal? @db.Decimal(5,2)
  allocations ProjectAllocation[]
  @@unique([projectLocationId, masterItemId])
}

model ProjectAllocation {
  id String @id @default(uuid())
  requirementId String
  requirement ProjectRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  vendorId String
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorItemId String?
  vendorItem VendorItem? @relation(fields: [vendorItemId], references: [id], onDelete: SetNull)
  qty Int
  unitPrice Decimal @db.Decimal(14,2)
  priceUnit PriceUnit
  notes String?
  supplyAllocations LocationSupplyAllocation[]
  @@unique([requirementId, vendorId])
  @@index([vendorId])
}

model ProjectProposal {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version Int
  documentNumber String @unique
  snapshot Json
  costTotal Decimal @db.Decimal(18,2)
  sellTotal Decimal @db.Decimal(18,2)
  createdAt DateTime @default(now())
  @@unique([projectId, version])
}

model LocationSupplyAllocation {
  id String @id @default(uuid())
  locationItemId String
  locationItem LocationItem @relation(fields: [locationItemId], references: [id], onDelete: Cascade)
  projectAllocationId String?
  projectAllocation ProjectAllocation? @relation(fields: [projectAllocationId], references: [id], onDelete: SetNull)
  vendorId String
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  qty Int
  unitPrice Decimal @db.Decimal(14,2)
  priceUnit PriceUnit
  @@index([locationItemId])
}
